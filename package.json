{
  "name": "hr-personnel-demo",
  "version": "1.0.0",
  "private": true,
  "description": "本地人员管理系统 Demo",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "setup": "npm install",
    "dev:web": "npm run dev --workspace=@hr-demo/frontend",
    "dev:api": "npm run dev --workspace=@hr-demo/backend",
    "dev:frontend": "npm run dev:web",
    "dev:backend": "npm run dev:api",
    "build": "npm run build --workspace=@hr-demo/shared && npm run build --workspace=@hr-demo/backend && npm run build --workspace=@hr-demo/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace=@hr-demo/backend",
    "db:migrate": "npm run prisma:deploy --workspace=@hr-demo/backend",
    "db:migrate:dev": "npm run prisma:migrate --workspace=@hr-demo/backend",
    "db:seed": "npm run prisma:seed --workspace=@hr-demo/backend",
    "db:replace-position-catalog": "npm run prisma:replace-position-catalog --workspace=@hr-demo/backend",
    "db:upsert-position-catalog": "npm run prisma:upsert-position-catalog --workspace=@hr-demo/backend",
    "db:replace-organization-catalog": "npm run prisma:replace-organization-catalog --workspace=@hr-demo/backend"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf": false,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
