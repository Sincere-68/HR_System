# 默认演示方式：不需要安装或启动数据库
# 如需使用本文件，请把后端部分复制为 backend/.env。
DEMO_MODE=true
PORT=3000
FRONTEND_URL="http://localhost:5173"

# 可选的 MySQL 设置（仅在 README 的进阶方式中使用）
DATABASE_URL="mysql://hr_demo:change_this_local_password@localhost:3306/hr_personnel_demo"
DATABASE_URL_TEST="mysql://hr_demo:change_this_local_password@localhost:3306/hr_personnel_demo_test"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
# 仅在首次运行数据库 seed、且 users 表中不存在 admin 时使用；之后修改此值不会覆盖管理员密码，可从实际 .env 删除。
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-local-admin-password"

# 飞书自建应用推送（可选；完整绩效模块需要 DEMO_MODE=false）
# 在飞书开放平台的“凭证与基础信息”中获取 App ID 与 App Secret。
# 不要将真实 App Secret 提交到 Git、前端 .env、日志或测试数据中。
FEISHU_ENABLED=false
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
# 个人推送通过员工企业邮箱（可回退手机号）查询飞书通讯录中的唯一 open_id。
# 应用需要通讯录读取和向用户发送消息权限；不需要填写群聊 chat_id。
# 卡片回调/长连接（填入 backend/.env，不要填入前端环境变量）：
FEISHU_LONG_CONNECTION_ENABLED=false
FEISHU_VERIFICATION_TOKEN=""
FEISHU_ENCRYPT_KEY=""
# Verification Token、Encrypt Key：飞书开放平台 → 事件与回调 → 事件配置。
# 汇总待办网页授权可在 backend/.env 配置 FEISHU_OAUTH_REDIRECT_URI、
# FEISHU_TASK_INBOX_URL 与 FEISHU_TASK_SESSION_TTL_SECONDS。

# 可选的网页端设置（如需使用，请复制为 frontend/.env）
VITE_API_BASE_URL="http://localhost:3000/api/v1"
