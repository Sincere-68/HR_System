# 默认演示方式：不需要安装或启动数据库
# 如需使用本文件，请把后端部分复制为 backend/.env。
DEMO_MODE=true
PORT=3000
FRONTEND_URL="http://localhost:5173"

# 可选的 MySQL 设置（仅在 README 的进阶方式中使用）
DATABASE_URL="mysql://hr_demo:change_this_local_password@localhost:3306/hr_personnel_demo"
DATABASE_URL_TEST="mysql://hr_demo:change_this_local_password@localhost:3306/hr_personnel_demo_test"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
SEED_ADMIN_PASSWORD="Demo@123"
SEED_DEPT_ADMIN_PASSWORD="Demo@123"
SEED_VIEWER_PASSWORD="Demo@123"

# 可选的网页端设置（如需使用，请复制为 frontend/.env）
VITE_API_BASE_URL="http://localhost:3000/api/v1"
