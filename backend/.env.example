# 默认演示方式：不需要安装或启动数据库
DEMO_MODE=true
PORT=3000
FRONTEND_URL="http://localhost:5173"

# 以下内容只在需要将数据长期保存到 PostgreSQL 时使用。
DATABASE_URL="postgresql://hr_user:change_this_local_password@localhost:5432/hr_system?schema=public"
DATABASE_URL_TEST="postgresql://hr_user:change_this_local_password@localhost:5432/hr_system_test?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
# 设置为本地安全密码；不要提交真实或共用密码。
SEED_ADMIN_PASSWORD="replace-with-local-admin-password"
SEED_DEPT_ADMIN_PASSWORD="replace-with-local-department-admin-password"
SEED_VIEWER_PASSWORD="replace-with-local-normal-account-password"
