# 默认演示方式：不需要安装或启动数据库
DEMO_MODE=true
PORT=3000
FRONTEND_URL="http://localhost:5173"

# 以下内容只在需要将数据长期保存到 PostgreSQL 时使用。
DATABASE_URL="postgresql://hr_user:change_this_local_password@localhost:5432/hr_system?schema=public"
DATABASE_URL_TEST="postgresql://hr_user:change_this_local_password@localhost:5432/hr_system_test?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
# 仅在首次运行数据库 seed、且 users 表中不存在 admin 时使用；之后修改此值不会覆盖管理员密码，可从实际 .env 删除。
# 不要提交真实或共用密码。HR 和普通员工账号由 users 表维护。
BOOTSTRAP_ADMIN_PASSWORD="replace-with-local-admin-password"

# 飞书个人推送与卡片回调（完整绩效模块需要 DEMO_MODE=false）
# App ID、App Secret：飞书开放平台 → 开发者后台 → 凭证与基础信息。
# 不要将真实 App Secret、Verification Token 或 Encrypt Key 提交到 Git、日志、测试或前端环境变量。
FEISHU_ENABLED=false
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 飞书交互卡片回调。长连接适合内网后端，不需要把卡片回调 HTTP 地址暴露到公网。
# Verification Token、Encrypt Key：飞书开放平台 → 事件与回调 → 事件配置。
# 若使用卡片 action.trigger 长连接，需在飞书后台启用对应事件。
FEISHU_LONG_CONNECTION_ENABLED=false
FEISHU_VERIFICATION_TOKEN=""
FEISHU_ENCRYPT_KEY=""

# 飞书个人绩效待办网页授权（仅在需要从一张汇总卡片进入项目待办时配置）。
# 该地址必须在飞书开放平台登记为网页授权回调地址，且与此处完全一致。
FEISHU_OAUTH_REDIRECT_URI="https://hr.example.com/performance/feishu-task-inbox"
FEISHU_TASK_INBOX_URL="https://hr.example.com/performance/feishu-task-inbox"
FEISHU_TASK_SESSION_TTL_SECONDS=600
