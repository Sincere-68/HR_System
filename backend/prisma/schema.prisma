enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
  ARCHIVED
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  roles     RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                         String                    @id @default(cuid())
  username                   String                    @unique
  passwordHash               String                    @map("password_hash")
  displayName                String                    @map("display_name")
  roleId                     String                    @map("role_id")
  employeeId                 String?                   @unique @map("employee_id")
  status                     RecordStatus              @default(ACTIVE)
  archivedAt                 DateTime?                 @map("archived_at")
  role                       Role                      @relation(fields: [roleId], references: [id])
  employee                   Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  dataScopes                 UserDataScope[]
  auditLogs                  AuditLog[]
  uploadedFiles              FileAttachment[]          @relation("FileUploader")
  approvalRequests           ApprovalRequest[]         @relation("ApprovalApplicant")
  approvalSteps              ApprovalStep[]            @relation("ApprovalApprover")
  reportDefinitions          ReportDefinition[]        @relation("ReportCreator")
  archivedOrganizations      Organization[]            @relation("OrganizationArchivedBy")
  archivedEmployees          Employee[]                @relation("EmployeeArchivedBy")
  evaluatedAppraisals        EmployeeAppraisal[]       @relation("AppraisalEvaluator")
  createdBlacklistRecords    EmployeeBlacklistRecord[] @relation("BlacklistCreator")
  ownedOnboardingCases       OnboardingCase[]          @relation("OnboardingOwner")
  responsibleOnboardingTasks OnboardingTask[]          @relation("OnboardingTaskResponsible")
  evaluatedTrialPosts        TrialPostRecord[]         @relation("TrialPostEvaluator")
  ownedHandoverCases         HandoverCase[]            @relation("HandoverOwner")
  employeeFieldChangeLogs    EmployeeFieldChangeLog[]
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")

  @@index([status, archivedAt])
  @@map("users")
}

model Organization {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  parentId         String?              @map("parent_id")
  sortOrder        Int                  @default(0) @map("sort_order")
  status           RecordStatus         @default(ACTIVE)
  effectiveDate    DateTime?            @map("effective_date") @db.Date
  expiryDate       DateTime?            @map("expiry_date") @db.Date
  description      String?              @db.Text
  archivedAt       DateTime?            @map("archived_at")
  archivedById     String?              @map("archived_by_id")
  archiveReason    String?              @map("archive_reason") @db.Text
  archivedBy       User?                @relation("OrganizationArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  parent           Organization?        @relation("OrganizationTree", fields: [parentId], references: [id])
  children         Organization[]       @relation("OrganizationTree")
  legacyEmployees  Employee[]           @relation("LegacyEmployeeOrganization")
  assignments      EmployeeAssignment[]
  positions        Position[]
  jobTitles        JobTitle[]
  scopes           UserDataScope[]
  offers           Offer[]
  movementFrom     EmployeeMovement[]   @relation("MovementFromOrganization")
  movementTo       EmployeeMovement[]   @relation("MovementToOrganization")
  staffingPlans    StaffingPlan[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([archivedById])
  @@index([status, archivedAt])
  @@map("organizations")
}

model UserDataScope {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_data_scopes")
}

model Employee {
  id                 String        @id @default(cuid())
  employeeNo         String        @unique @map("employee_no")
  name               String
  formerName         String?       @map("former_name")
  englishName        String?       @map("english_name")
  gender             Gender?
  birthDate          DateTime?     @map("birth_date") @db.Date
  nationality        String?
  ethnicity          Ethnicity?
  nativePlace        String?       @map("native_place")
  politicalStatus    PoliticalStatus? @map("political_status")
  maritalStatus      MaritalStatus? @map("marital_status")
  mobile             String
  personalEmail      String?       @map("personal_email")
  workEmail          String?       @map("work_email")
  householdType      HouseholdType? @map("household_type")
  householdAddress   String?       @map("household_address") @db.Text
  residentialAddress String?       @map("residential_address") @db.Text
  bankName           BankName?     @map("bank_name")
  bankBranchName     String?       @map("bank_branch_name")
  bankAccountNumber  String?       @map("bank_account_number") @db.VarChar(19)
  profilePhotoId     String?       @unique @map("profile_photo_id")
  recordStatus       RecordStatus  @default(ACTIVE) @map("record_status")
  archivedAt         DateTime?     @map("archived_at")
  archivedById       String?       @map("archived_by_id")
  archiveReason      String?       @map("archive_reason") @db.Text
  archivedBy         User?         @relation("EmployeeArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  // Compatibility fields used by the current employee API. New modules use
  // EmployeeAssignment and EmployeeIdentityDocument instead.
  idCardNo       String?      @unique @map("id_card_no")
  organizationId String       @map("organization_id")
  organization   Organization @relation("LegacyEmployeeOrganization", fields: [organizationId], references: [id])

  profilePhoto         FileAttachment?               @relation("EmployeeProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)
  user                 User?
  employmentRecords    EmploymentRecord[]
  employmentPeriods    EmploymentPeriod[]
  assignments          EmployeeAssignment[]
  assignmentChangeLogs EmployeeFieldChangeLog[]
  reportingAsEmployee  ReportingRelationship[]       @relation("ReportingEmployee")
  reportingAsManager   ReportingRelationship[]       @relation("ReportingManager")
  identityDocuments    EmployeeIdentityDocument[]
  familyMembers        EmployeeFamilyMember[]
  educationExperiences EmployeeEducationExperience[]
  workExperiences      EmployeeWorkExperience[]
  appraisals           EmployeeAppraisal[]
  trainingRecords      EmployeeTrainingRecord[]
  awards               EmployeeAward[]
  certificates         EmployeeCertificate[]
  projects             EmployeeProjectExperience[]
  skills               EmployeeSkill[]
  languages            EmployeeLanguageAbility[]
  documents            EmployeeDocument[]
  blacklistRecords     EmployeeBlacklistRecord[]
  changeRequests       EmployeeChangeRequest[]
  onboardingCases      OnboardingCase[]
  integrationRecords   OnboardingIntegrationRecord[]
  introductions        EmployeeIntroduction[]
  probationRecords     ProbationRecord[]
  movements            EmployeeMovement[]
  trialPostRecords     TrialPostRecord[]
  terminationRecords   TerminationRecord[]
  retirementRecords    RetirementRecord[]
  agreements           EmployeeAgreement[]
  acceptedOffers       Offer[]
  convertedCandidates  Candidate[]                   @relation("ConvertedCandidate")
  outgoingHandovers    HandoverCase[]                @relation("HandoverSource")
  incomingHandovers    HandoverCase[]                @relation("HandoverTarget")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  @@index([name])
  @@index([organizationId])
  @@index([archivedById])
  @@index([recordStatus, archivedAt])
  @@map("employees")
}

model EmployingCompany {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  sortOrder   Int          @default(0) @map("sort_order")
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  archivedAt  DateTime?    @map("archived_at")
  agreements  EmployeeAgreement[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, sortOrder])
  @@map("employing_companies")
}

model Position {
  id               String               @id @default(cuid())
  code             String               @unique
  name             String
  organizationId   String?              @map("organization_id")
  category         String?
  description      String?              @db.Text
  status           RecordStatus         @default(ACTIVE)
  archivedAt       DateTime?            @map("archived_at")
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments      EmployeeAssignment[]
  offers           Offer[]
  movementFrom     EmployeeMovement[]   @relation("MovementFromPosition")
  movementTo       EmployeeMovement[]   @relation("MovementToPosition")
  trialPostRecords TrialPostRecord[]
  staffingPlans    StaffingPlan[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("positions")
}

model JobTitle {
  id             String               @id @default(cuid())
  code           String               @unique
  name           String
  organizationId String?              @map("organization_id")
  description    String?              @db.Text
  status         RecordStatus         @default(ACTIVE)
  archivedAt     DateTime?            @map("archived_at")
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    EmployeeAssignment[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([organizationId, status])
  @@map("job_titles")
}

model Workplace {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  address     String?              @db.Text
  status      RecordStatus         @default(ACTIVE)
  archivedAt  DateTime?            @map("archived_at")
  assignments EmployeeAssignment[]
  offers      Offer[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([status, archivedAt])
  @@map("workplaces")
}

model EmploymentPeriod {
  id                 String               @id @default(cuid())
  employeeId         String               @map("employee_id")
  sequenceNo         Int                  @map("sequence_no")
  personnelCategory     PersonnelCategory?      @map("personnel_category")
  personnelSource       PersonnelSource?        @map("personnel_source")
  employmentRelationship EmploymentRelationship @map("employment_relationship")
  entryDate          DateTime             @map("entry_date") @db.Date
  plannedExitDate    DateTime?            @map("planned_exit_date") @db.Date
  actualExitDate     DateTime?            @map("actual_exit_date") @db.Date
  employmentStatus   EmploymentStatus     @default(REGULAR) @map("employment_status")
  isRehire           Boolean              @default(false) @map("is_rehire")
  previousPeriodId   String?              @map("previous_period_id")
  exitReason         String?              @map("exit_reason") @db.Text
  status             RecordStatus         @default(ACTIVE)
  archivedAt         DateTime?            @map("archived_at")
  employee           Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  previousPeriod     EmploymentPeriod?    @relation("EmploymentPeriodHistory", fields: [previousPeriodId], references: [id], onDelete: Restrict)
  nextPeriods        EmploymentPeriod[]   @relation("EmploymentPeriodHistory")
  assignments        EmployeeAssignment[]
  employmentRecords  EmploymentRecord[]
  probationRecords   ProbationRecord[]
  terminationRecords TerminationRecord[]
  retirementRecords  RetirementRecord[]
  agreements         EmployeeAgreement[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@unique([employeeId, sequenceNo])
  @@index([employeeId, employmentStatus, actualExitDate])
  @@index([personnelCategory, employmentStatus])
  @@index([personnelSource, employmentStatus])
  @@index([employmentRelationship, employmentStatus])
  @@map("employment_periods")
}

model EmployeeAssignment {
  id                 String            @id @default(cuid())
  employeeId         String            @map("employee_id")
  employmentPeriodId String?           @map("employment_period_id")
  organizationId     String            @map("organization_id")
  positionId         String?           @map("position_id")
  jobLevel           JobLevelCode?     @map("job_level")
  jobTitleId         String?           @map("job_title_id")
  workplaceId             String?                @map("workplace_id")
  personnelPosition       PersonnelPosition?     @map("personnel_position")
  employeeLevel           EmployeeLevel?         @map("employee_level")
  personnelCategory       PersonnelCategory?      @map("personnel_category")
  personnelSource         PersonnelSource?        @map("personnel_source")
  employmentRelationship  EmploymentRelationship? @map("employment_relationship")
  assignmentType          AssignmentType         @default(PRIMARY) @map("assignment_type")
  workArrangement         WorkArrangement        @map("work_arrangement")
  isPrimary          Boolean           @default(false) @map("is_primary")
  startDate          DateTime          @map("start_date") @db.Date
  endDate            DateTime?         @map("end_date") @db.Date
  status             AssignmentStatus  @default(ACTIVE)
  changeReason       String?           @map("change_reason") @db.Text
  archivedAt         DateTime?         @map("archived_at")
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentPeriod   EmploymentPeriod? @relation(fields: [employmentPeriodId], references: [id], onDelete: Restrict)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position           Position?         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  jobTitle           JobTitle?         @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  workplace          Workplace?        @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  fieldChangeLogs    EmployeeFieldChangeLog[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([employeeId, status, endDate])
  @@index([organizationId, status, endDate])
  @@index([personnelCategory, status])
  @@index([employmentRelationship, status])
  @@index([employmentPeriodId])
  @@index([jobLevel, status])
  @@index([personnelPosition, status])
  @@index([employeeLevel, status])
  @@index([isPrimary, status])
  @@map("employee_assignments")
}

model ReportingRelationship {
  id                String                    @id @default(cuid())
  employeeId        String                    @map("employee_id")
  managerEmployeeId String                    @map("manager_employee_id")
  relationshipType  ReportingRelationshipType @map("relationship_type")
  isPrimary         Boolean                   @default(false) @map("is_primary")
  startDate         DateTime                  @map("start_date") @db.Date
  endDate           DateTime?                 @map("end_date") @db.Date
  status            RecordStatus              @default(ACTIVE)
  archivedAt        DateTime?                 @map("archived_at")
  employee          Employee                  @relation("ReportingEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  manager           Employee                  @relation("ReportingManager", fields: [managerEmployeeId], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([employeeId, status, endDate])
  @@index([managerEmployeeId, status, endDate])
  @@map("reporting_relationships")
}

model EmployeeIdentityDocument {
  id                String               @id @default(cuid())
  employeeId        String               @map("employee_id")
  documentType      IdentityDocumentType @map("document_type")
  documentNumber    String               @map("document_number")
  isPrimary         Boolean              @default(false) @map("is_primary")
  issuingCountry    String?              @map("issuing_country")
  issuingAuthority  String?              @map("issuing_authority")
  issueDate         DateTime?            @map("issue_date") @db.Date
  expiryDate        DateTime?            @map("expiry_date") @db.Date
  frontAttachmentId String?              @map("front_attachment_id")
  backAttachmentId  String?              @map("back_attachment_id")
  status            RecordStatus         @default(ACTIVE)
  archivedAt        DateTime?            @map("archived_at")
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  frontAttachment   FileAttachment?      @relation("IdentityDocumentFront", fields: [frontAttachmentId], references: [id], onDelete: SetNull)
  backAttachment    FileAttachment?      @relation("IdentityDocumentBack", fields: [backAttachmentId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([documentType, documentNumber])
  @@index([employeeId, status])
  @@index([expiryDate, status])
  @@map("employee_identity_documents")
}

model EmploymentRecord {
  id                 String            @id @default(cuid())
  employeeId         String            @map("employee_id")
  employmentPeriodId String?           @map("employment_period_id")
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentPeriod   EmploymentPeriod? @relation(fields: [employmentPeriodId], references: [id], onDelete: Restrict)
  status             EmploymentStatus
  effectiveAt        DateTime          @map("effective_at")
  endedAt            DateTime?         @map("ended_at")
  currentFlag        Boolean?          @default(true) @map("current_flag")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@unique([employeeId, currentFlag])
  @@index([employeeId, endedAt])
  @@index([status, currentFlag])
  @@index([employmentPeriodId])
  @@map("employment_records")
}

model FileAttachment {
  id                String                     @id @default(cuid())
  originalName      String                     @map("original_name")
  storageKey        String                     @unique @map("storage_key")
  mimeType          String                     @map("mime_type")
  fileSize          BigInt                     @map("file_size")
  checksum          String?
  uploadedById      String?                    @map("uploaded_by_id")
  status            RecordStatus               @default(ACTIVE)
  archivedAt        DateTime?                  @map("archived_at")
  uploader          User?                      @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  profilePhotoFor   Employee?                  @relation("EmployeeProfilePhoto")
  identityFrontFor  EmployeeIdentityDocument[] @relation("IdentityDocumentFront")
  identityBackFor   EmployeeIdentityDocument[] @relation("IdentityDocumentBack")
  employeeDocuments EmployeeDocument[]
  certificates      EmployeeCertificate[]
  agreements        EmployeeAgreement[]
  handoverItems     HandoverItem[]
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@index([uploadedById, status])
  @@map("file_attachments")
}

model EmployeeFamilyMember {
  id                 String       @id @default(cuid())
  employeeId         String       @map("employee_id")
  relationship       String
  name               String
  gender             Gender?
  birthDate          DateTime?    @map("birth_date") @db.Date
  identityDocumentNo String?      @map("identity_document_no")
  mobile             String?
  workOrganization   String?      @map("work_organization")
  positionName       String?      @map("position_name")
  address            String?      @db.Text
  isEmergencyContact Boolean      @default(false) @map("is_emergency_contact")
  isDependent        Boolean      @default(false) @map("is_dependent")
  remark             String?      @db.Text
  status             RecordStatus @default(ACTIVE)
  archivedAt         DateTime?    @map("archived_at")
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@map("employee_family_members")
}

model EmployeeEducationExperience {
  id                 String       @id @default(cuid())
  employeeId         String       @map("employee_id")
  schoolName         String          @map("school_name")
