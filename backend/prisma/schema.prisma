  salaryRemark                                 String?      @map("salary_remark") @db.Text
  preConfirmationBaseSalary                    Decimal?     @map("pre_confirmation_base_salary") @db.Decimal(12, 2)
  postConfirmationBaseSalary                   Decimal?     @map("post_confirmation_base_salary") @db.Decimal(12, 2)
  preConfirmationMonthlyPerformance            Decimal?     @map("pre_confirmation_monthly_performance") @db.Decimal(12, 2)
  postConfirmationMonthlyPerformance           Decimal?     @map("post_confirmation_monthly_performance") @db.Decimal(12, 2)
  preConfirmationMonthlyManagementPerformance  Decimal?     @map("pre_confirmation_monthly_management_performance") @db.Decimal(12, 2)
  postConfirmationMonthlyManagementPerformance Decimal?     @map("post_confirmation_monthly_management_performance") @db.Decimal(12, 2)
  fullTimeContractSalary                       Decimal?     @map("full_time_contract_salary") @db.Decimal(12, 2)
  annualPerformance                            Decimal?     @map("annual_performance") @db.Decimal(12, 2)
  status                                       RecordStatus @default(ACTIVE)
  archivedAt                                   DateTime?    @map("archived_at")
  offer                                        Offer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  createdAt                                    DateTime     @default(now()) @map("created_at")
  updatedAt                                    DateTime     @updatedAt @map("updated_at")

  @@index([status, archivedAt])
  @@map("offer_compensation_snapshots")
}

