  oldValue     Json?               @map("old_value")
  newValue     Json?               @map("new_value")
  changedById  String?             @map("changed_by_id")
  changedAt    DateTime            @default(now()) @map("changed_at")
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignment   EmployeeAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  changedBy    User?               @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([employeeId, changedAt])
  @@index([assignmentId, changedAt])
  @@index([changedById, changedAt])
  @@map("employee_field_change_logs")
}

model ApprovalRequest {
  id                    String                 @id @default(cuid())
  businessType          String                 @map("business_type")
  businessId            String?                @map("business_id")
  applicantUserId       String                 @map("applicant_user_id")
  title                 String
  currentStep           Int                    @default(1) @map("current_step")
  status                ProcessStatus          @default(DRAFT)
  submittedAt           DateTime?              @map("submitted_at")
  completedAt           DateTime?              @map("completed_at")
  archivedAt            DateTime?              @map("archived_at")
  applicant             User                   @relation("ApprovalApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  steps                 ApprovalStep[]
  employeeChangeRequest EmployeeChangeRequest?
  employeeMovement      EmployeeMovement?
  terminationRecord     TerminationRecord?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([businessType, businessId])
  @@index([applicantUserId, status])
  @@index([status, submittedAt])
  @@map("approval_requests")
}

model ApprovalStep {
  id                String           @id @default(cuid())
  approvalRequestId String           @map("approval_request_id")
  stepOrder         Int              @map("step_order")
  approverUserId    String           @map("approver_user_id")
  decision          ApprovalDecision @default(PENDING)
  comment           String?          @db.Text
  operatedAt        DateTime?        @map("operated_at")
  approvalRequest   ApprovalRequest  @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approver          User             @relation("ApprovalApprover", fields: [approverUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([approvalRequestId, stepOrder])
  @@index([approverUserId, decision])
  @@map("approval_steps")
}

model EmployeeChangeRequest {
  id                String           @id @default(cuid())
  employeeId        String           @map("employee_id")
  approvalRequestId String?          @unique @map("approval_request_id")
  changedFields     Json             @map("changed_fields")
  oldValues         Json?            @map("old_values")
  newValues         Json             @map("new_values")
  status            ProcessStatus    @default(DRAFT)
  archivedAt        DateTime?        @map("archived_at")
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@map("employee_change_requests")
}

model StaffingPlan {
  id                String        @id @default(cuid())
  organizationId    String        @map("organization_id")
  positionId        String?       @map("position_id")
  planYear          Int           @map("plan_year")
  approvedHeadcount Int           @map("approved_headcount")
  frozenHeadcount   Int           @default(0) @map("frozen_headcount")
  status            ProcessStatus @default(DRAFT)
  archivedAt        DateTime?     @map("archived_at")
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position          Position?     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, positionId, planYear])
  @@index([planYear, status])
  @@map("staffing_plans")
}

model HandoverCase {
  id                String             @id @default(cuid())
  sourceEmployeeId  String             @map("source_employee_id")
  targetEmployeeId  String?            @map("target_employee_id")
  reason            String?            @db.Text
  plannedDate       DateTime?          @map("planned_date") @db.Date
  completedDate     DateTime?          @map("completed_date") @db.Date
  ownerUserId       String?            @map("owner_user_id")
  status            ProcessStatus      @default(DRAFT)
  archivedAt        DateTime?          @map("archived_at")
  sourceEmployee    Employee           @relation("HandoverSource", fields: [sourceEmployeeId], references: [id], onDelete: Restrict)
  targetEmployee    Employee?          @relation("HandoverTarget", fields: [targetEmployeeId], references: [id], onDelete: Restrict)
  ownerUser         User?              @relation("HandoverOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  items             HandoverItem[]
  terminationRecord TerminationRecord?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([sourceEmployeeId, status])
  @@index([targetEmployeeId, status])
  @@index([ownerUserId, status])
  @@map("handover_cases")
}

model HandoverItem {
  id                 String          @id @default(cuid())
  handoverCaseId     String          @map("handover_case_id")
  itemType           String          @map("item_type")
  itemName           String          @map("item_name")
  description        String?         @db.Text
  attachmentId       String?         @map("attachment_id")
  confirmationStatus TaskStatus      @default(PENDING) @map("confirmation_status")
  confirmedAt        DateTime?       @map("confirmed_at")
  remark             String?         @db.Text
  handoverCase       HandoverCase    @relation(fields: [handoverCaseId], references: [id], onDelete: Cascade)
  attachment         FileAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([handoverCaseId, confirmationStatus])
  @@map("handover_items")
}

model DictionaryType {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?          @db.Text
  status      RecordStatus     @default(ACTIVE)
  items       DictionaryItem[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("dictionary_types")
}

model DictionaryItem {
  id               String         @id @default(cuid())
  dictionaryTypeId String         @map("dictionary_type_id")
  code             String
  name             String
  sortOrder        Int            @default(0) @map("sort_order")
  extraData        Json?          @map("extra_data")
  status           RecordStatus   @default(ACTIVE)
  archivedAt       DateTime?      @map("archived_at")
  dictionaryType   DictionaryType @relation(fields: [dictionaryTypeId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([dictionaryTypeId, code])
  @@index([dictionaryTypeId, status, sortOrder])
  @@map("dictionary_items")
}

model ReportDefinition {
  id             String       @id @default(cuid())
  name           String
  dataSource     String       @map("data_source")
  selectedFields Json         @map("selected_fields")
  filters        Json?
  grouping       Json?
  sorting        Json?
  creatorUserId  String       @map("creator_user_id")
  visibility     String       @default("PRIVATE")
  status         RecordStatus @default(ACTIVE)
  archivedAt     DateTime?    @map("archived_at")
  creator        User         @relation("ReportCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([creatorUserId, status])
  @@map("report_definitions")
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?     @map("user_id")
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  metadata     Json?
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
