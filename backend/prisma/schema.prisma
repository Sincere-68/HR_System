model Offer {
  id                      String                     @id @default(cuid())
  offerNo                 String                     @unique @map("offer_no")
  candidateId             String                     @map("candidate_id")
  acceptedEmployeeId      String?                    @map("accepted_employee_id")
  organizationId          String?                    @map("organization_id")
  positionId              String?                    @map("position_id")
  workplaceId             String?                    @map("workplace_id")
  /// Snapshot only. No ReportingRelationship is created when an Offer is saved.
  directManagerEmployeeId String?                    @map("direct_manager_employee_id")
  jobLevel                JobLevelCode?              @map("job_level")
  employeeLevel           EmployeeLevel?             @map("employee_level")
  personnelCategory       PersonnelCategory?         @map("personnel_category")
  workArrangement         WorkArrangement?           @map("work_arrangement")
  employingCompanyId      String?                    @map("employing_company_id")
  agreementType           AgreementType?             @map("agreement_type")
  /// Application-level enum: FIXED or OPEN_ENDED; not persisted as a database enum.
  contractTermType        String?                    @map("contract_term_type") @db.VarChar(32)
  contractMonths          Int?                       @map("contract_months")
  contractEndDate         DateTime?                  @map("contract_end_date") @db.Date
  isSeparatelySigned      Boolean?                   @map("is_separately_signed")
  employmentRelationship  EmploymentRelationship     @map("employment_relationship")
  proposedEntryDate       DateTime?                  @map("proposed_entry_date") @db.Date
  probationMonths         Int?                       @map("probation_months")
  offeredMonthlySalary    Decimal?                   @map("offered_monthly_salary") @db.Decimal(12, 2)
  issueDate               DateTime?                  @map("issue_date") @db.Date
  expiryDate              DateTime?                  @map("expiry_date") @db.Date
  acceptedAt              DateTime?                  @map("accepted_at")
  rejectedReason          String?                    @map("rejected_reason") @db.Text
  status                  ProcessStatus              @default(DRAFT)
  archivedAt              DateTime?                  @map("archived_at")
  candidate               Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  acceptedEmployee        Employee?                  @relation("AcceptedOfferEmployee", fields: [acceptedEmployeeId], references: [id], onDelete: SetNull)
  directManagerEmployee   Employee?                  @relation("OfferDirectManager", fields: [directManagerEmployeeId], references: [id], onDelete: Restrict)
  organization            Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position                Position?                  @relation(fields: [positionId], references: [id], onDelete: Restrict)
  workplace               Workplace?                 @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  employingCompany        EmployingCompany?          @relation("OfferEmployingCompany", fields: [employingCompanyId], references: [id], onDelete: Restrict)
  compensationSnapshot    OfferCompensationSnapshot?
  partTimeSnapshot        OfferPartTimeSnapshot?
  onboardingCase          OnboardingCase?
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  @@index([candidateId, status])
  @@index([organizationId, proposedEntryDate])
  @@index([directManagerEmployeeId])
  @@index([employingCompanyId])
  @@map("offers")
}

